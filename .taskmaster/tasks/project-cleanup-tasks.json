          "id": "SEC-001",
          "title": "Audit Environment Variables",
          "description": "Review all .env files for exposed secrets and API keys",
          "priority": "CRITICAL",
          "estimatedTime": "10 minutes",
          "files": [".env", "backend/.env", ".env.example"],
          "actions": [
            "Check for exposed API keys",
            "Validate Supabase key security",
            "Ensure .env is in .gitignore"
          ]
        },
        {
          "id": "SEC-002", 
          "title": "Scan Source Code for Hardcoded Secrets",
          "description": "Search codebase for hardcoded API keys, passwords, and secrets",
          "priority": "HIGH",
          "estimatedTime": "15 minutes",
          "files": ["src/**/*.tsx", "src/**/*.ts", "backend/**/*.js"],
          "actions": [
            "Search for 'API_KEY', 'PASSWORD', 'SECRET' patterns",
            "Check for hardcoded URLs and credentials",
            "Validate environment variable usage"
          ]
        },
        {
          "id": "SEC-003",
          "title": "Review Authentication Security",
          "description": "Audit authentication flows and session management",
          "priority": "HIGH", 
          "estimatedTime": "5 minutes",
          "files": ["src/hooks/useAuth.tsx", "src/components/auth/"],
          "actions": [
            "Review JWT token handling",
            "Check session storage security",
            "Validate password policies"
          ]
        }
      ]
    },
