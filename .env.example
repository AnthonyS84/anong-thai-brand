# Supabase Configuration
# For development: Use your actual Supabase project values
# For production: Set these as environment variables in your hosting platform
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Security Configuration
VITE_ENVIRONMENT=development
VITE_CSRF_SECRET=your-csrf-secret-key

# Backend Configuration  
VITE_BACKEND_URL=http://localhost:5000

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Never commit the .env file with real credentials to git
# 4. For production, set these as environment variables in Render/Vercel/etc.
